{
	"name": "pi-apply-patch",
	"version": "0.1.4",
	"description": "Codex-style apply_patch tool extension for the pi coding agent. Registers a freeform grammar patch tool for OpenAI GPT models and applies patches with Node path resolution.",
	"type": "module",
	"license": "MIT",
	"homepage": "https://github.com/code-yeongyu/pi-apply-patch",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/code-yeongyu/pi-apply-patch.git"
	},
	"bugs": {
		"url": "https://github.com/code-yeongyu/pi-apply-patch/issues"
	},
	"keywords": [
		"pi",
		"pi-mono",
		"pi-coding-agent",
		"pi-extension",
		"coding-agent",
		"apply-patch",
		"codex",
		"openai",
		"gpt",
		"typescript"
	],
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"files": [
		"src",
		"CHANGELOG.md",
		"NOTICE"
	],
	"scripts": {
		"test": "vitest --run",
		"test:watch": "vitest",
		"typecheck": "tsgo --noEmit",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"check": "tsgo --noEmit && biome check ."
	},
	"peerDependencies": {
		"@earendil-works/pi-agent-core": "*",
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"typebox": "*"
	},
	"peerDependenciesMeta": {
		"@earendil-works/pi-agent-core": {
			"optional": true
		},
		"@earendil-works/pi-ai": {
			"optional": true
		},
		"@earendil-works/pi-coding-agent": {
			"optional": true
		},
		"@earendil-works/pi-tui": {
			"optional": true
		},
		"typebox": {
			"optional": true
		}
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@earendil-works/pi-agent-core": "1.0.4",
		"@earendil-works/pi-ai": "1.0.4",
		"@earendil-works/pi-coding-agent": "1.0.4",
		"@earendil-works/pi-tui": "1.0.4",
		"@types/node": "26.6.4",
		"@typescript/native-preview": "7.0.0-dev.20260707.2",
		"typebox": "1.3.36",
		"typescript": "7.0.2",
		"vitest": "5.0.3"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"dependencies": {
		"diff": "^9.0.0"
	}
}
